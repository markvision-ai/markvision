{
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/workbox-(.*).js", "destination": "/workbox-$1.js" },
    { "source": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|webp|ico|json|map))", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
