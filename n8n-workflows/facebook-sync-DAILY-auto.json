      ]
    },
    "Check If Exists": {
      "main": [[{"node": "Merge Data", "type": "main", "index": 0}]]
    },
    "Merge Data": {
      "main": [[{"node": "Update or Create?", "type": "main", "index": 0}]]
    },
    "Update or Create?": {
      "main": [
        [{"node": "Update Record", "type": "main", "index": 0}],
        [{"node": "Create Record", "type": "main", "index": 0}]
      ]
    },
    "Update Record": {
      "main": [[{"node": "Log Success", "type": "main", "index": 0}]]
    },
    "Create Record": {
      "main": [[{"node": "Log Success", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
