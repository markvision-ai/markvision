{
  "name": "MarkVision_FB_Daily_Auto_Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "cronExpression", "expression": "0 9 * * *"}]
        }
      },
      "id": "schedule",
      "name": "Every Day 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v21.0/act_1005197113823722/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "EAAa3xKWvHHYBQiBIpZAlq7wLCrHpaprzQxoORky0vGRFsxOTSVW4uPEm1Sc7njSfuZBzUzxC87dqU8dr1ru0UZADrJTK8Qi1RlPgZCDWfoTVYxT9QqgoKVMqI6mcDEObnxElrnOIS3QZA7fUfeuplrZCbKnEAuGZAqelr2nP0F13oZACJQTpLBc7rWXZBI0ti"
            },
            {
              "name": "fields",
              "value": "spend,impressions,clicks,reach,ctr,cpc,cpm,actions"
            },
            {
              "name": "level",
              "value": "account"
            },
            {
              "name": "date_preset",
              "value": "yesterday"
            },
            {
              "name": "time_increment",
              "value": "1"
            }
          ]
        },
        "options": {"timeout": 30000}
      },
      "id": "fb-request",
      "name": "Get FB Yesterday",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nif (!input || !input.data || input.data.length === 0) {\n  console.log('⚠️ No data from Facebook API for yesterday');\n  return { json: { skip: true, reason: 'no_data' } };\n}\n\nconst fbData = input.data[0];\nconst projectId = '64c94e87-630c-470e-8ab1-8f7c8c835efa';\n\nconst yesterday = new Date();\nyesterday.setDate(yesterday.getDate() - 1);\nconst yesterdayStr = yesterday.toISOString().split('T')[0];\n\nfunction safeParse(value, decimals = 2) {\n  const num = parseFloat(value || 0);\n  return isNaN(num) ? 0 : parseFloat(num.toFixed(decimals));\n}\n\nfunction safeInt(value) {\n  const num = parseInt(value || 0, 10);\n  return isNaN(num) ? 0 : num;\n}\n\nfunction extractAction(actions, actionTypes) {\n  if (!actions || !Array.isArray(actions)) return 0;\n  \n  for (const type of actionTypes) {\n    const action = actions.find(a => a.action_type === type);\n    if (action) return safeInt(action.value);\n  }\n  return 0;\n}\n\nconst leads = extractAction(fbData.actions, ['lead', 'leadgen_grouped']);\nconst conversations = extractAction(fbData.actions, [\n  'onsite_conversion.messaging_conversation_started_7d',\n  'onsite_conversion.messaging_first_reply',\n  'onsite_conversion.post_save'\n]);\n\nconst result = {\n  project_id: projectId,\n  date: yesterdayStr,\n  spend: safeParse(fbData.spend, 2),\n  impressions: safeInt(fbData.impressions),\n  clicks: safeInt(fbData.clicks),\n  reach: safeInt(fbData.reach),\n  ctr: safeParse(fbData.ctr, 4),\n  cpc: safeParse(fbData.cpc, 2),\n  cpm: safeParse(fbData.cpm, 2),\n  leads: leads,\n  conversations: conversations,\n  source: 'facebook_ads',\n  account_id: 'act_1005197113823722',\n  skip: false\n};\n\nconsole.log('✅ Transformed data:', JSON.stringify(result));\nreturn { json: result };"
      },
      "id": "transform",
      "name": "Transform Yesterday",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{"value1": "={{ $json.skip }}", "value2": false}]
        }
      },
      "id": "should-continue",
      "name": "Has Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "marketing_stats",
        "returnAll": true,
        "filters": {
          "conditions": [
            {"keyName": "project_id", "condition": "equals", "keyValue": "={{ $json.project_id }}"},
            {"keyName": "date", "condition": "equals", "keyValue": "={{ $json.date }}"},
            {"keyName": "source", "condition": "equals", "keyValue": "facebook_ads"}
          ]
        }
      },
      "id": "check-exists",
      "name": "Check If Exists",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1120, 240],
      "credentials": {
        "supabaseApi": {
          "id": "your_supabase_credential_id",
          "name": "MarkVision Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const fbData = $input.first().json;\nconst existingData = $input.all()[0]?.json;\n\nif (existingData && existingData.id) {\n  return {\n    json: {\n      ...fbData,\n      id: existingData.id,\n      action: 'update'\n    }\n  };\n} else {\n  return {\n    json: {\n      ...fbData,\n      action: 'create'\n    }\n  };\n}"
      },
      "id": "merge",
      "name": "Merge Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 240]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{"value1": "={{ $json.action }}", "value2": "update"}]
        }
      },
      "id": "action-router",
      "name": "Update or Create?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "marketing_stats",
        "filterType": "manual",
        "matchBy": [{"key": "id", "value": "={{ $json.id }}"}],
        "dataMode": "defineBelow",
        "columnsUi": {
          "columnValues": [
            {"column": "spend", "value": "={{ $json.spend }}"},
            {"column": "impressions", "value": "={{ $json.impressions }}"},
            {"column": "clicks", "value": "={{ $json.clicks }}"},
            {"column": "reach", "value": "={{ $json.reach }}"},
            {"column": "ctr", "value": "={{ $json.ctr }}"},
            {"column": "cpc", "value": "={{ $json.cpc }}"},
            {"column": "cpm", "value": "={{ $json.cpm }}"},
            {"column": "leads", "value": "={{ $json.leads }}"},
            {"column": "conversations", "value": "={{ $json.conversations }}"}
          ]
        }
      },
      "id": "update-record",
      "name": "Update Record",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1780, 180],
      "credentials": {
        "supabaseApi": {
          "id": "your_supabase_credential_id",
          "name": "MarkVision Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "marketing_stats",
        "dataMode": "defineBelow",
        "columnsUi": {
          "columnValues": [
            {"column": "project_id", "value": "={{ $json.project_id }}"},
            {"column": "date", "value": "={{ $json.date }}"},
            {"column": "spend", "value": "={{ $json.spend }}"},
            {"column": "impressions", "value": "={{ $json.impressions }}"},
            {"column": "clicks", "value": "={{ $json.clicks }}"},
            {"column": "reach", "value": "={{ $json.reach }}"},
            {"column": "ctr", "value": "={{ $json.ctr }}"},
            {"column": "cpc", "value": "={{ $json.cpc }}"},
            {"column": "cpm", "value": "={{ $json.cpm }}"},
            {"column": "leads", "value": "={{ $json.leads }}"},
            {"column": "conversations", "value": "={{ $json.conversations }}"},
            {"column": "source", "value": "facebook_ads"}
          ]
        }
      },
      "id": "create-record",
      "name": "Create Record",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1780, 420],
      "credentials": {
        "supabaseApi": {
          "id": "your_supabase_credential_id",
          "name": "MarkVision Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "console.log('✅ Daily sync completed');\nreturn { json: { success: true, message: 'Facebook data synced successfully' } };"
      },
      "id": "log-success",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "jsCode": "console.error('❌ Sync failed:', $input.first().json);\nreturn { json: { success: false, error: $input.first().json } };"
      },
      "id": "error-handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 500]
    }
  ],
  "connections": {
    "Every Day 9 AM": {
      "main": [[{"node": "Get FB Yesterday", "type": "main", "index": 0}]]
    },
    "Get FB Yesterday": {
      "main": [[{"node": "Transform Yesterday", "type": "main", "index": 0}]]
    },
    "Transform Yesterday": {
