            {
              "name": "apikey",
              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB5c2NjemN1ZXJzZGp2cG1raWVjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NjY1ODI4NSwiZXhwIjoyMDgyMjM0Mjg1fQ.oLXVUjT7oB163L4rsS9XMHwe43THPPKyJLU-LgnnIuE"
            },
            {
              "name": "Authorization",
              "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB5c2NjemN1ZXJzZGp2cG1raWVjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NjY1ODI4NSwiZXhwIvoyMDgyMjM0Mjg1fQ.oLXVUjT7oB163L4rsS9XMHwe43THPPKyJLU-LgnnIuE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "jsonBody",
              "value": "={{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "alwaysOutputData": true
        }
      },
      "id": "save-to-supabase-01",
      "name": "💾 Сохранить в Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 300]
    },
    {
      "parameters": {
        "jsCode": "const result = $('💾 Сохранить в Supabase').first().json;\nconst metrics = $('🧮 Рассчитать метрики').first().json;\n\n// HTTP статус 200-299 считается успехом, даже если тело пустое\nconsole.log(`\\n💾 Сохранение в Supabase:`);\nconsole.log(`   HTTP статус: ${result.statusCode || 'неизвестен'}`);\nconsole.log(`   Успешно: ${result.statusCode >= 200 && result.statusCode < 300 ? 'ДА' : 'НЕТ'}`);\n\nif (result.statusCode >= 200 && result.statusCode < 300) {\n  console.log(`\\n✅ Данные успешно сохранены!`);\n  console.log(`   Период: ${metrics.period_start} - ${metrics.period_end}`);\n  console.log(`   Метрики: Публикации=${metrics.publications}, Подписчики=${metrics.followers || 0}`);\n} else {\n  console.log(`\\n❌ Ошибка сохранения:`);\n  console.log(`   Ответ: ${JSON.stringify(result, null, 2)}`);\n}\n\nreturn {\n  json: {\n    success: result.statusCode >= 200 && result.statusCode < 300,\n    message: result.statusCode >= 200 && result.statusCode < 300 ? 'Данные сохранены' : 'Ошибка сохранения',\n    statusCode: result.statusCode,\n    ...metrics\n  }\n};"
      },
      "id": "process-save-response-01",
      "name": "🔍 Обработать ответ (Supabase)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "jsCode": "const result = $('🔍 Обработать ответ (Supabase)').first().json;\n\nif (result.success) {\n  console.log(`\\n✅ ИТОГОВЫЙ РЕЗУЛЬТАТ:`);\n  console.log(`   ${result.message}`);\n  console.log(`   Период: ${result.period_start} - ${result.period_end}`);\n  if (result.publications !== undefined) {\n    console.log(`   Публикации: ${result.publications}`);\n    console.log(`   Охват: ${(result.reach || 0).toLocaleString('ru-RU')}`);\n    console.log(`   Комментарии: ${result.comments || 0}`);\n    console.log(`   Подписчики: ${result.followers || 0}`);\n    console.log(`   Диагностики: ${result.diagnostics || 0}`);\n    console.log(`   Продажи: ${result.sales || 0}`);\n    console.log(`   Выручка: ${(result.revenue || 0).toLocaleString('ru-RU')}₸`);\n  }\n} else {\n  console.log(`\\n❌ ОШИБКА:`);\n  console.log(`   ${result.error || 'Unknown error'}`);\n  if (result.details) {\n    console.log(`   Details: ${result.details}`);\n  }\n}\n\nreturn {\n  json: result\n};"
      },
      "id": "success-log-01",
      "name": "✅ Лог успеха",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 300]
    }
  ],
  "connections": {
