{
  "name": "📊 Агрегатор статистики Instagram (1-22 января)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 1 * * *"
            }
          ]
        }
      },
      "id": "schedule-01",
      "name": "⏰ Расписание (01:05 каждый день)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Рассчитываем период: с 1 января по вчера\nconst today = new Date();\nconst yesterday = new Date(today);\nyesterday.setDate(yesterday.getDate() - 1);\n\nconst periodStart = new Date('2026-01-01');\nconst periodEnd = yesterday;\n\n// Форматируем даты для timestamp\n// Период: 00:00:00 первого дня - 23:59:59 последнего дня\nconst periodStartTimestamp = Math.floor(periodStart.getTime() / 1000);\nconst periodEndTimestamp = Math.floor(periodEnd.getTime() / 1000) + 86399; // +23:59:59\n\nconsole.log(`📅 Период агрегации: ${periodStart.toISOString().split('T')[0]} - ${periodEnd.toISOString().split('T')[0]}`);\nconsole.log(`   Timestamp start: ${periodStartTimestamp}`);\nconsole.log(`   Timestamp end: ${periodEndTimestamp}`);\n\nreturn {\n  json: {\n    period_start: periodStart.toISOString().split('T')[0],\n    period_end: periodEnd.toISOString().split('T')[0],\n    period_start_timestamp: periodStartTimestamp,\n    period_end_timestamp: periodEndTimestamp\n  }\n};"
      },
      "id": "calculate-period-01",
      "name": "📅 Рассчитать период (1 янв - вчера)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Формируем URL для получения постов из instagram_posts_stats\nconst periodData = $('📅 Рассчитать период (1 янв - вчера)').first().json;\nconst periodStart = periodData.period_start;\nconst periodEnd = periodData.period_end;\n\nconst url = `https://pysccczcuersdjvpmkiec.supabase.co/rest/v1/instagram_posts_stats?project_id=eq.64c94e87-630c-470e-8ab1-8f7c8c835efa&posted_at=gte.${periodStart}&posted_at=lte.${periodEnd}&order=posted_at.asc`;\n\nconsole.log(`🔗 Сформирован URL: ${url}`);\n\nreturn {\n  json: {\n    url: url,\n    period_start: periodStart,\n    period_end: periodEnd,\n    period_start_timestamp: periodData.period_start_timestamp,\n    period_end_timestamp: periodData.period_end_timestamp\n  }\n};"
      },
      "id": "build-url-01",
      "name": "🔗 Сформировать URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB5c2NjemN1ZXJzZGp2cG1raWVjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NjY1ODI4NSwiZXhwIjoyMDgyMjM0Mjg1fQ.oLXVUjT7oB163L4rsS9XMHwe43THPPKyJLU-LgnnIuE"
            },
            {
              "name": "Authorization",
              "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB5c2NjemN1ZXJzZGp2cG1raWVjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NjY1ODI4NSwiZXhwIjoyMDgyMjM0Mjg1fQ.oLXVUjT7oB163L4rsS9XMHwe43THPPKyJLU-LgnnIuE"
            }
          ]
        },
        "options": {
          "timeout": 30000,
