      "id": "get-followers-basic-01",
      "name": "👥 Получить подписчиков",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v21.0/17841464802410425/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "EAAa3xKWvHHYBQqKLp1WfZA6ZBLeddlHCwrkFkLsLyZAJUR5ugf5jbGAW0dwS9AUDsI6Q0oYCPXucAkQHZA0E5d2ah2HsGI0FEUNfwwRnkY4C9BwXzZA4ZCK3jT7NKfYWnle3JUYSf7vyuVNw0bz5Td0xxIYhEWn2ZC7mrKK8K6ZBKohcOmIMVRVmNOlsk7Hp"
            },
            {
              "name": "metric",
              "value": "follows_and_unfollows"
            },
            {
              "name": "metric_type",
              "value": "total_value"
            },
            {
              "name": "period",
              "value": "day"
            },
            {
              "name": "since",
              "value": "={{ $json.period_start_timestamp }}"
            },
            {
              "name": "until",
              "value": "={{ $json.period_end_timestamp }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "alwaysOutputData": true
        }
      },
      "id": "get-followers-gained-01",
      "name": "👥 Получить новых подписчиков",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "jsCode": "// Теперь workflow идет последовательно:\n// 1. Получить посты → 2. Получить подписчиков → 3. Получить новых подписчиков → 4. Рассчитать метрики\n\n// Получаем период из предыдущего узла\nconst periodData = $('📅 Рассчитать период (1 янв - вчера)').first().json;\nconst periodStart = periodData.period_start;\nconst periodEnd = periodData.period_end;\n\n// Получаем посты из предыдущей ноды\nlet posts = [];\ntry {\n  const postsNode = $('🔍 Обработать ответ (посты)');\n  if (postsNode) {\n    const postsItems = postsNode.all();\n    posts = postsItems.map(item => item.json);\n  }\n} catch (e) {\n  console.log('⚠️ Не удалось получить посты из ноды:', e.message);\n  posts = $input.all().filter(item => Array.isArray(item.json) || (item.json.post_id || item.json.id)).map(item => item.json);\n}\n\nconsole.log(`\\n📊 Получено постов за период ${periodStart} - ${periodEnd}: ${posts.length}`);\n\nif (posts.length === 0) {\n  console.log('⚠️ Нет постов за этот период в instagram_posts_stats');\n  console.log('   Проверь, что данные загружены через INSTAGRAM-CONTENT-INTELLIGENCE-FIXED.json');\n  console.log('   Или проверь, что в таблице есть посты за период 1-22 января 2026');\n  return { json: { skip: true, reason: 'no_posts', message: 'Нет постов за период 1-22 января' } };\n}\n\n// Считаем метрики\n// Считаем Публикации (Reels, Carousels, обычные посты - без Stories)\nconst publications = posts.filter(p => {\n  const mediaType = (p.media_type || '').toLowerCase();\n  return !mediaType.includes('story') && mediaType !== 'stories';\n}).length;\n\n// Суммируем метрики\nconst totalReach = posts.reduce((sum, p) => sum + (p.reach || 0), 0);\nconst totalImpressions = posts.reduce((sum, p) => sum + (p.impressions || 0), 0);\nconst totalLikes = posts.reduce((sum, p) => sum + (p.likes || 0), 0);\nconst totalShares = posts.reduce((sum, p) => sum + (p.shares || 0), 0);\n\n// Комментарии = сумма всех комментариев\nconst totalCommentsCount = posts.reduce((sum, p) => sum + (p.comments || 0), 0);\n\n// Бизнес-метрики\nconst totalDiagnostics = posts.reduce((sum, p) => sum + (p.leads_count || 0), 0);\nconst totalSales = posts.reduce((sum, p) => sum + (p.paid_leads || 0), 0);\nconst totalRevenue = posts.reduce((sum, p) => sum + (p.revenue || 0), 0);\n\n// Получаем подписчиков из Instagram API\n// Пробуем два способа:\n// 1. Текущее количество из базовой информации аккаунта\n// 2. Новые подписчики за период из Insights API\nlet totalFollowers = 0;\n\ntry {\n  // Получаем текущее количество подписчиков из предыдущей ноды\n  const followersNode = $('👥 Получить подписчиков');\n  let currentFollowers = 0;\n  \n  if (followersNode) {\n    const nodeData = followersNode.first().json;\n    console.log('\\n📊 ДАННЫЕ О ПОДПИСЧИКАХ (базовая информация):');\n    console.log(JSON.stringify(nodeData, null, 2));\n    \n    if (nodeData.error) {\n      console.log('❌ Ошибка от Instagram API (базовая информация):', nodeData.error.message);\n    } else if (nodeData.followers_count !== undefined) {\n      currentFollowers = parseInt(nodeData.followers_count) || 0;\n      console.log(`✅ Текущее количество подписчиков: ${currentFollowers}`);\n    }\n  }\n  \n  // Получаем новых подписчиков за период из предыдущей ноды\n  const followersGainedNode = $('👥 Получить новых подписчиков');\n  let newFollowers = 0;\n  \n  if (followersGainedNode) {\n    const nodeData = followersGainedNode.first().json;\n    console.log('\\n📊 ДАННЫЕ О НОВЫХ ПОДПИСЧИКАХ (Insights API):');\n    console.log(JSON.stringify(nodeData, null, 2));\n    \n    if (nodeData.error) {\n      console.log('❌ Ошибка от Instagram Insights API:', nodeData.error.message);\n      console.log('   Код:', nodeData.error.code);\n      console.log('   Тип:', nodeData.error.type);\n    } else if (nodeData && nodeData.data && Array.isArray(nodeData.data)) {\n      const followsMetric = nodeData.data.find(m => m.name === 'follows_and_unfollows');\n      \n      if (followsMetric) {\n        console.log(`\\n✅ Найдена метрика: ${followsMetric.name}`);\n        \n        // С metric_type=total_value формат ответа может быть другим\n        // Проверяем разные форматы ответа\n        if (followsMetric.values && Array.isArray(followsMetric.values)) {\n          console.log(`   Количество значений: ${followsMetric.values.length}`);\n          \n          // Метрика follows_and_unfollows с total_value возвращает объект с полями follows и unfollows\n          newFollowers = followsMetric.values.reduce((sum, v) => {\n            const value = v.value || {};\n            const follows = parseInt(value.follows || 0);\n            const unfollows = parseInt(value.unfollows || 0);\n            const net = follows - unfollows; // Чистый прирост\n            return sum + (net > 0 ? net : 0); // Только положительные значения\n          }, 0);\n        } else if (followsMetric.value) {\n          // Если это total_value, может быть одно значение\n          const value = followsMetric.value || {};\n          const follows = parseInt(value.follows || 0);\n          const unfollows = parseInt(value.unfollows || 0);\n          newFollowers = follows - unfollows;\n          if (newFollowers < 0) newFollowers = 0;\n        }\n        \n        console.log(`   Новых подписчиков за период (чистый прирост): ${newFollowers}`);\n      } else {\n        console.log('⚠️ Метрика follows_and_unfollows не найдена в ответе');\n        console.log('   Доступные метрики:', nodeData.data.map(m => m.name).join(', '));\n      }\n    }\n  }\n  \n  // Используем новых подписчиков за период (если есть), иначе текущее количество\n  totalFollowers = newFollowers > 0 ? newFollowers : currentFollowers;\n  \n  console.log(`\\n📊 ИТОГО:`);\n  console.log(`   Текущее количество: ${currentFollowers}`);\n  console.log(`   Новых за период: ${newFollowers}`);\n  console.log(`   Используем: ${totalFollowers}`);\n  \n} catch (e) {\n  console.log('❌ Ошибка получения подписчиков:', e.message);\n  console.log('   Stack:', e.stack);\n  totalFollowers = 0;\n}\n\nconst projectId = '64c94e87-630c-470e-8ab1-8f7c8c835efa';\n\nconst result = {\n  project_id: projectId,\n  period_start: periodStart,\n  period_end: periodEnd,\n  publications: publications,\n  reach: totalReach,\n  comments: totalCommentsCount,\n  followers: totalFollowers, // Получаем из Instagram Insights API\n  diagnostics: totalDiagnostics,\n  sales: totalSales,\n  revenue: Math.round(totalRevenue), // БЕЗ КОПЕЕК\n};\n\nconsole.log(`\\n✅ Агрегированные метрики за ${periodStart} - ${periodEnd}:`);\nconsole.log(`   Публикации: ${publications}`);\nconsole.log(`   Охват: ${(totalReach || 0).toLocaleString('ru-RU')}`);\nconsole.log(`   Комментарии: ${totalCommentsCount}`);\nconsole.log(`   Подписчики: ${totalFollowers}`);\nconsole.log(`   Диагностики: ${totalDiagnostics}`);\nconsole.log(`   Продажи: ${totalSales}`);\nconsole.log(`   Выручка: ${(totalRevenue || 0).toLocaleString('ru-RU')}₸`);\n\nreturn { json: result };"
      },
      "id": "calculate-stats-01",
      "name": "🧮 Рассчитать метрики",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "jsCode": "const result = $('🧮 Рассчитать метрики').first().json;\n\nif (result.skip) {\n  console.log(`⚠️ ${result.message}`);\n  return { json: { success: false, message: result.message } };\n}\n\n// Определяем, успешно ли выполнение\nconst success = result.publications !== undefined && result.publications >= 0;\n\nconsole.log(`\\n✅ Агрегация завершена: ${success ? 'УСПЕХ' : 'ОШИБКА'}`);\n\nif (success) {\n  console.log(`   Период: ${result.period_start} - ${result.period_end}`);\n  console.log(`   Публикации: ${result.publications}`);\n  console.log(`   Подписчики: ${result.followers || 0}`);\n}\n\nreturn {\n  json: {\n    success: success,\n    message: success ? 'Метрики успешно агрегированы' : 'Ошибка агрегации метрик',\n    period_start: result.period_start,\n    period_end: result.period_end,\n    ...result\n  }\n};"
      },
      "id": "check-skip-01",
      "name": "❓ Проверить пропуск",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pysccczcuersdjvpmkiec.supabase.co/rest/v1/content_production_stats",
        "authentication": "none",
