      "id": "get-posts-01",
      "name": "📊 Получить посты из Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// Обрабатываем ответ от Supabase\nconst response = $input.first().json;\n\n// Supabase может возвращать данные в разных форматах\nlet posts = [];\n\nif (Array.isArray(response)) {\n  posts = response;\n} else if (response.data && Array.isArray(response.data)) {\n  posts = response.data;\n} else if (response.body && Array.isArray(response.body)) {\n  posts = response.body;\n} else if (typeof response === 'object' && response !== null) {\n  // Если вернулся один объект, преобразуем в массив\n  posts = [response];\n}\n\nconsole.log(`🔍 Получено постов из Supabase: ${posts.length}`);\n\nif (posts.length > 0) {\n  console.log('📄 Первый пост:', JSON.stringify(posts[0], null, 2));\n}\n\nreturn {\n  json: posts\n};"
      },
      "id": "process-response-01",
      "name": "🔍 Обработать ответ (посты)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
