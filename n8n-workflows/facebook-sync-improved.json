      "id": "create-record",
      "name": "Create Record",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1780, 300],
      "credentials": {
        "supabaseApi": {
          "id": "your_supabase_credential_id",
          "name": "MarkVision Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst result = {\n  success: true,\n  action: input.id ? 'updated' : 'created',\n  recordId: input.id,\n  date: input.date,\n  spend: input.spend,\n  message: `✅ Facebook stats ${input.id ? 'updated' : 'created'} successfully`\n};\n\nconsole.log(result.message, result);\n\nreturn { json: result };"
      },
      "id": "log-success",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "jsCode": "const errorData = $input.first().json;\n\nconsole.error('❌ Facebook sync failed:', errorData);\n\n// You can add notification logic here (email, Slack, etc)\n\nreturn { json: { \n  success: false, \n  error: errorData,\n  message: 'Facebook sync failed - check logs'\n} };"
      },
      "id": "error-handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 500],
      "onError": "continueErrorOutput"
    }
