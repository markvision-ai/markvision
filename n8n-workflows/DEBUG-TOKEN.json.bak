        "jsCode": "const debugData = $('Debug Token').first().json;\nconst permissionsData = $('Check Permissions').first().json;\nconst insightsData = $('Test Insights API').first().json;\n\nconsole.log('=== TOKEN DEBUG ===');\nconsole.log(JSON.stringify(debugData, null, 2));\n\nconsole.log('\\n=== PERMISSIONS ===');\nconsole.log(JSON.stringify(permissionsData, null, 2));\n\nconsole.log('\\n=== INSIGHTS RESPONSE ===');\nconsole.log(JSON.stringify(insightsData, null, 2));\n\nreturn {\n  json: {\n    token_info: debugData,\n    permissions: permissionsData,\n    insights: insightsData,\n    timestamp: new Date().toISOString()\n  }\n};"
