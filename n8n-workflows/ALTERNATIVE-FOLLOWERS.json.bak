      "id": "save-to-db",
      "name": "Save to Database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const currentData = $('Get Current Followers').first().json;\nconst saveResponse = $('Save to Database').first().json;\n\nconst currentFollowers = currentData.followers_count || 0;\nconst today = new Date().toISOString().split('T')[0]; // YYYY-MM-DD\n\nconsole.log(`=== FOLLOWERS TRACKING ===`);\nconsole.log(`📅 Date: ${today}`);\nconsole.log(`👥 Current Followers: ${currentFollowers}`);\nconsole.log(`💾 Save Status: ${saveResponse.statusCode >= 200 && saveResponse.statusCode < 300 ? 'SUCCESS' : 'FAILED'}`);\n\n// Для расчета новых подписчиков нужно будет сравнивать с предыдущими днями\n// Пока просто сохраняем текущее количество\nreturn {\n  json: {\n    date: today,\n    followers_count: currentFollowers,\n    project_id: '64c94e87-630c-470e-8ab1-8f7c8c835efa',\n    saved: saveResponse.statusCode >= 200 && saveResponse.statusCode < 300\n  }\n};"
      },
      "id": "process-and-log",
      "name": "Process and Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
