      "id": "supabase-query-01",
      "name": "💾 Query Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "const postData = $input.first().json;\nconst leadsData = $input.last().json;\n\nif (!Array.isArray(leadsData)) {\n  console.log(`⚠️ Нет лидов для поста ${postData.post_id}`);\n  return {\n    json: {\n      ...postData,\n      leads_count: 0,\n      revenue: 0,\n      paid_leads: 0\n    }\n  };\n}\n\nconst leadsCount = leadsData.length;\nconst paidLeads = leadsData.filter(l => l.status === 'purchased' || l.status === 'paid');\nconst revenue = paidLeads.reduce((sum, l) => sum + (l.deal_amount || 0), 0);\n\nconsole.log(`💰 Post ${postData.post_id}: ${leadsCount} лидов, ${paidLeads.length} оплачено, ${revenue}₸ выручки`);\n\nreturn {\n  json: {\n    ...postData,\n    leads_count: leadsCount,\n    revenue: Math.round(revenue), // БЕЗ КОПЕЕК\n    paid_leads: paidLeads.length\n  }\n};"
      },
