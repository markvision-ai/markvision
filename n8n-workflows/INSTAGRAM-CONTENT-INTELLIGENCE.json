    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nif (!input || !input.data || input.data.length === 0) {\n  console.log('⚠️ Нет постов от Instagram');\n  return { json: { skip: true, reason: 'no_posts' } };\n}\n\nconst posts = input.data;\nconsole.log(`📊 Получено постов: ${posts.length}`);\n\n// Возвращаем массив постов для дальнейшей обработки\nreturn posts.map(post => ({\n  json: {\n    post_id: post.id,\n    caption: post.caption || '',\n    media_type: post.media_type,\n    media_url: post.media_url,\n    posted_at: post.timestamp,\n    permalink: post.permalink\n  }\n}));"
      },
