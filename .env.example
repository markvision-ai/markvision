# ===== Supabase Configuration =====
# Get these from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===== Anthropic (for Edge Functions) =====
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===== OpenAI (for Embeddings) =====
# Optional but required for RAG functionality
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ===== kie.ai (Supabase Edge Functions only) =====
# Video generation via the kie-video edge function.
# Get from https://kie.ai/api-key, then set in
# Supabase Dashboard → Edge Functions → Secrets as KIE_API_KEY.
# Never expose it with a VITE_ prefix — that ships the key to the browser.
# kie.ai also supports an IP whitelist per key; enable it for production.
#
# KIE_CALLBACK_URL    — public URL of the kie-video-callback function,
#                       e.g. https://<project>.supabase.co/functions/v1/kie-video-callback
# KIE_CALLBACK_SECRET — random string; guards the callback endpoint
# PUBLISH_WEBHOOK_URL — n8n autoposting webhook (publishing-video-ready), optional
# PUBLISH_WEBHOOK_KEY — its x-publish-key header, optional
# Without the callback pair the pipeline still works, but the client has to poll.

# ===== Meta (Supabase Edge Functions only) =====
# Optional. Set in Supabase Dashboard → Edge Functions → Secrets as META_ACCESS_TOKEN.
# Or save token in app: Integrations → Meta → "Токен Meta (ручной ввод)".

# ===== Environment =====
# Set to 'development' or 'production'
NODE_ENV=development
