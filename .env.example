# ===== Supabase Configuration =====
# Get these from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===== Anthropic (for Edge Functions) =====
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===== OpenAI (for Embeddings) =====
# Optional but required for RAG functionality
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ===== Meta (Supabase Edge Functions only) =====
# Optional. Set in Supabase Dashboard → Edge Functions → Secrets as META_ACCESS_TOKEN.
# Or save token in app: Integrations → Meta → "Токен Meta (ручной ввод)".

# ===== Environment =====
# Set to 'development' or 'production'
NODE_ENV=development
